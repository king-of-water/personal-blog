---
import { SITE } from '../config';

interface Props { activePath?: string }

const { activePath } = Astro.props;
const pathname = Astro.url.pathname;
const resolvedActivePath = activePath ?? (
	pathname === '/' ? '/' :
	pathname.startsWith('/backend/') ? '/backend/' :
	pathname.startsWith('/agent/') ? '/agent/' :
	pathname.startsWith('/projects/') ? '/projects/' :
	pathname.startsWith('/toolbox/') ? '/toolbox/' :
	pathname.startsWith('/about/') ? '/about/' :
	pathname.startsWith('/posts/') ? '/posts/' : ''
);

const navItems = [
	{ href: '/', label: '首页' },
	{ href: '/backend/', label: '后端' },
	{ href: '/agent/', label: 'Agent' },
	{ href: '/projects/', label: '项目' },
	{ href: '/toolbox/', label: '工具箱' },
	{ href: '/about/', label: '关于作者' },
	{ href: '/posts/', label: '归档' },
];
---

<header class="site-header">
	<nav class="nav shell" aria-label="主导航">
		<a class="brand" href="/">
			<img class="brand-mark" src="/images/avatar.jpg" alt={`${SITE.author} 的头像`} width="36" height="36" />
			<span class="brand-copy">
				<strong>{SITE.title}</strong>
				<small>technical notes & projects</small>
			</span>
		</a>
		<div class="nav-links">
			{navItems.map((item) => (
				<a
					href={item.href}
					class:list={{ 'is-active': resolvedActivePath === item.href }}
					aria-current={resolvedActivePath === item.href ? 'page' : undefined}
				>{item.label}</a>
			))}
			<a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
		</div>
	</nav>
</header>
