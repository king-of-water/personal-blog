---
import { SITE } from '../config';

interface Props { activePath?: string }

const { activePath } = Astro.props;
const pathname = Astro.url.pathname;
const resolvedActivePath = activePath ?? (
	pathname === '/' ? '/' :
	pathname.startsWith('/backend/') ? '/backend/' :
	pathname.startsWith('/agent/') ? '/agent/' :
	pathname.startsWith('/industry/') ? '/industry/' :
	pathname.startsWith('/projects/') ? '/projects/' :
	pathname.startsWith('/toolbox/') ? '/about/' :
	pathname.startsWith('/about/') ? '/about/' :
	pathname.startsWith('/posts/') ? '/posts/' : ''
);

const navItems = [
	{ href: '/', label: '首页' },
	{ href: '/backend/', label: '后端' },
	{ href: '/agent/', label: 'Agent' },
	{ href: '/industry/', label: '行业' },
	{ href: '/projects/', label: '项目' },
	{ href: '/about/', label: '个人' },
	{ href: '/posts/', label: '归档' },
];
---

<header class="site-header">
	<nav class="nav shell" aria-label="主导航">
		<a class="brand" href="/">
			<img class="brand-mark" src="/images/avatar.jpg" alt={`${SITE.author} 的头像`} width="36" height="36" />
			<span class="brand-copy">
				<strong>{SITE.title}</strong>
				<small>technical notes & projects</small>
			</span>
		</a>
		<div class="nav-links">
			{navItems.map((item) => (
				<a
					href={item.href}
					class:list={{ 'is-active': resolvedActivePath === item.href }}
					aria-current={resolvedActivePath === item.href ? 'page' : undefined}
				>{item.label}</a>
			))}
			<button class="theme-toggle" type="button" aria-label="切换到夜间模式" title="切换到夜间模式" aria-pressed="false">
				<span aria-hidden="true">☾</span>
			</button>
		</div>
	</nav>
</header>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const syncThemeToggle = () => {
		if (!themeToggle) return;
		const isDark = document.documentElement.dataset.theme === 'dark';
		themeToggle.setAttribute('aria-pressed', String(isDark));
		themeToggle.setAttribute('aria-label', isDark ? '切换到日间模式' : '切换到夜间模式');
		themeToggle.title = isDark ? '切换到日间模式' : '切换到夜间模式';
		themeToggle.querySelector('span')!.textContent = isDark ? '☀' : '☾';
		document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#17191b' : '#f7f7f4');
	};

	syncThemeToggle();
	themeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.dataset.theme !== 'dark';
		document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
		try { localStorage.setItem('king-of-water-theme', isDark ? 'dark' : 'light'); } catch {}
		syncThemeToggle();
	});
</script>
