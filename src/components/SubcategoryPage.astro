---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { categoryPath, type MainCategory, type PlannedTopic } from '../config/sections';
import { comparePostsBySeriesOrder } from '../utils/post-order';

interface Props {
	category: MainCategory;
	name: string;
	description: string;
	plannedTopics?: Array<string | PlannedTopic>;
}

const { category, name, description, plannedTopics = [] } = Astro.props;
const sectionPosts = (await getCollection('posts', ({ data }) => (
	data.category === category && data.subcategory === name
))).sort(comparePostsBySeriesOrder);
const posts = sectionPosts.filter((post) => !post.data.draft);
const hiddenPosts = sectionPosts.filter((post) => post.data.draft);
const publishedTitles = new Set(posts.map((post) => post.data.title));
const hiddenTitles = new Set(hiddenPosts.map((post) => post.data.title));
const seenTitles = new Set<string>();
const futureTopics = [
	...hiddenPosts.map((post) => ({ title: post.data.title, seriesOrder: post.data.seriesOrder ?? Number.MAX_SAFE_INTEGER, status: '待完善' })),
	...plannedTopics.map((topic, index) => ({
		title: typeof topic === 'string' ? topic : topic.title,
		seriesOrder: typeof topic === 'string' ? Number.MAX_SAFE_INTEGER - plannedTopics.length + index : topic.seriesOrder,
		status: '待深入',
	})).filter((topic) => !hiddenTitles.has(topic.title)),
].filter((topic) => {
	if (publishedTitles.has(topic.title) || seenTitles.has(topic.title)) return false;
	seenTitles.add(topic.title);
	return true;
}).sort((a, b) => a.seriesOrder - b.seriesOrder);
---

<BaseLayout title={`${name} · ${category}`} description={description} activeNav={categoryPath(category)}>
	<header class="page-intro shell subcategory-intro">
		<nav class="breadcrumb" aria-label="面包屑导航">
			<a href={categoryPath(category)}>{category}</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{name}</span>
		</nav>
		<h1>{name}</h1>
		<p>{description}</p>
	</header>
	<section class="section shell" aria-labelledby="subcategory-articles-title">
		<div class="section-label">
			<h2 id="subcategory-articles-title">文章</h2>
			<span>{posts.length > 0 ? `${posts.length} 篇` : '内容正在整理'}</span>
		</div>
		{posts.length > 0 ? (
			<div class="post-list">{posts.map((post, index) => (
				<PostCard post={post} sequence={index + 1} showCategory={false} />
			))}</div>
		) : (
			<div class="empty-state compact-empty-state">
				<h2>这里还没有文章</h2>
				<p>内容整理完成后，会从这里开始出现。</p>
			</div>
		)}
	</section>
	{futureTopics.length > 0 && (
		<section class="section shell topic-roadmap" aria-labelledby="planned-topics-title">
			<div class="section-label">
				<h2 id="planned-topics-title">后续深入</h2>
				<span>{futureTopics.length} 个主题</span>
			</div>
			<ol>
				{futureTopics.map((topic, index) => {
					const sequence = posts.length + index + 1;
					return <li><b>{String(sequence).padStart(2, '0')}</b><span>{topic.title}</span><small>{topic.status}</small></li>;
				})}
			</ol>
		</section>
	)}
</BaseLayout>
