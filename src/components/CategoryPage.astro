---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { categoryPath, type MainCategory } from '../config/sections';

interface Props {
	title: MainCategory;
	eyebrow: string;
	description: string;
	subcategories?: Array<{
		name: string;
		slug: string;
		description: string;
	}>;
}

const { title, eyebrow, description, subcategories = [] } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === title))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const sections = subcategories.map((subcategory) => ({
	...subcategory,
	posts: posts.filter((post) => post.data.subcategory === subcategory.name),
}));
---

<BaseLayout title={title} description={description}>
	<header class="page-intro shell">
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		<p>{description}</p>
	</header>
	<section class="category-content shell" aria-labelledby="subcategory-title">
		<h2 class="visually-hidden" id="subcategory-title">{title}的二级专栏</h2>
		{subcategories.length > 0 && (
			<nav class="subcategory-grid" aria-label={`${title} 子专栏`}>
				{sections.map((section) => (
					<a href={`${categoryPath(title)}${section.slug}/`} class:list={{ 'is-empty': section.posts.length === 0 }}>
						<div>
							<h2>{section.name}</h2>
							<p>{section.description}</p>
						</div>
						<small>{section.posts.length} 篇</small>
					</a>
				))}
			</nav>
		)}
		{subcategories.length === 0 && (
			<div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
		)}
	</section>
</BaseLayout>
