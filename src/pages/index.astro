---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const posts = allPosts.slice(0, 6);
const recentPosts = posts.slice(0, 3);
---

<BaseLayout>
	<section class="home-intro home-stage shell">
		<span class="home-folio" aria-hidden="true">Folio III · MMXXVI</span>
		<div class="intro-main">
			<h1>Hello, I am<br />king-of-water.</h1>
			<p>从代码出发，理解系统与行业。</p>
		</div>
		<aside class="home-recent" aria-labelledby="home-recent-title">
			<div class="home-recent-heading">
				<h2 id="home-recent-title">最近更新</h2>
				<a href="/posts/">全部文章</a>
			</div>
			{recentPosts.map((post) => (
				<a class="home-recent-item" href={`/posts/${post.id}/`}>
					<small>{post.data.subcategory ?? post.data.category}</small>
					<strong>{post.data.title}</strong>
				</a>
			))}
		</aside>
	</section>

	<section class="section shell" aria-labelledby="site-navigation-title">
		<div class="section-label">
			<h2 id="site-navigation-title">栏目</h2>
			<span>从一个方向开始</span>
		</div>
		<div class="topic-list">
			<a class="topic-row" href="/backend/"><span>01</span><h3>后端</h3><p>Java、数据库、分布式系统与可靠性实践。</p><b>→</b></a>
			<a class="topic-row" href="/agent/"><span>02</span><h3>Agent</h3><p>AI Agent、工作流、工具调用与应用探索。</p><b>→</b></a>
			<a class="topic-row" href="/industry/"><span>03</span><h3>行业</h3><p>从产品与业务切面，理解互联网公司的增长方式与生态位置。</p><b>→</b></a>
			<a class="topic-row" href="/projects/"><span>04</span><h3>项目</h3><p>从灵感、设计到上线的完整记录。</p><b>→</b></a>
			<a class="topic-row" href="/toolbox/"><span>05</span><h3>工具箱</h3><p>记录实际使用过的 Skills、写作工具和开发工具。</p><b>→</b></a>
			<a class="topic-row" href="/about/"><span>06</span><h3>关于作者</h3><p>了解我的学习方向，以及如何找到我。</p><b>→</b></a>
		</div>
	</section>

	<section class="section shell">
		<div class="section-label">
			<h2>最近更新</h2>
			<a href="/posts/">全部文章 →</a>
		</div>
		<div class="post-list">{posts.slice(1).map((post) => <PostCard post={post} />)}</div>
	</section>
</BaseLayout>
