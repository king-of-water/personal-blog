---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 6);
const featuredPost = posts.find((post) => post.data.featured);
const recentPosts = posts.filter((post) => post.id !== featuredPost?.id);
---

<BaseLayout>
	<section class="home-intro shell">
		<div class="intro-main">
			<p class="eyebrow">个人技术档案 · 2026</p>
			<h1>后端、Agent<br />与个人项目。</h1>
			<p>这里记录正在学习和实践的技术，也整理那些值得长期保留的项目过程。</p>
		</div>
		<aside class="intro-aside">
			<img src="/images/avatar.jpg" alt="King of Water 的头像" />
			<div>
				<span>NOW</span>
				<strong>正在搭建个人技术档案</strong>
				<p>从这个博客开始，把实践留下来。</p>
			</div>
		</aside>
	</section>

	{featuredPost && <section class="featured shell">
		<div class="section-label"><h2>置顶</h2><span>从这里开始</span></div>
		<a class="featured-post" href={`/posts/${featuredPost.id}/`}>
			<div><span class="post-category">{featuredPost.data.category}</span><h2>{featuredPost.data.title}</h2><p>{featuredPost.data.description}</p></div>
			<span aria-hidden="true">阅读 →</span>
		</a>
	</section>}

	<section class="section shell" aria-labelledby="site-navigation-title">
		<div class="section-label">
			<h2 id="site-navigation-title">栏目</h2>
			<span>从一个方向开始</span>
		</div>
		<div class="topic-list">
			<a class="topic-row" href="/backend/"><span>01</span><h3>后端</h3><p>Java、服务端架构、数据库与工程实践。</p><b>→</b></a>
			<a class="topic-row" href="/agent/"><span>02</span><h3>Agent</h3><p>AI Agent、工作流、工具调用与应用探索。</p><b>→</b></a>
			<a class="topic-row" href="/projects/"><span>03</span><h3>个人项目</h3><p>从灵感、设计到上线的完整记录。</p><b>→</b></a>
			<a class="topic-row" href="/about/"><span>04</span><h3>个人介绍</h3><p>了解这个站点，以及如何找到我。</p><b>→</b></a>
		</div>
	</section>

	<section class="section shell">
		<div class="section-label">
			<h2>最近更新</h2>
			<a href="/posts/">全部文章 →</a>
		</div>
		<div class="post-list">{recentPosts.map((post) => <PostCard post={post} />)}</div>
	</section>
</BaseLayout>
