---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 6);
---

<BaseLayout>
	<section class="home-intro shell">
		<div class="intro-main">
			<p class="eyebrow">king-of-water · 个人博客</p>
			<h1>你好，我是<br />king-of-water。</h1>
			<p>这里记录后端、Agent 实践和个人项目，也记录我如何把想法做出来。</p>
		</div>
		<aside class="intro-aside">
			<img src="/images/avatar.jpg" alt="king-of-water 的头像" />
			<div>
				<span>ABOUT THIS SITE</span>
				<strong>一个持续更新的个人空间</strong>
				<p>从一篇文章、一个项目开始。</p>
			</div>
		</aside>
	</section>

	<section class="section shell" aria-labelledby="site-navigation-title">
		<div class="section-label">
			<h2 id="site-navigation-title">栏目</h2>
			<span>从一个方向开始</span>
		</div>
		<div class="topic-list">
			<a class="topic-row" href="/backend/"><span>01</span><h3>后端</h3><p>Java、服务端架构、数据库与工程实践。</p><b>→</b></a>
			<a class="topic-row" href="/agent/"><span>02</span><h3>Agent</h3><p>AI Agent、工作流、工具调用与应用探索。</p><b>→</b></a>
			<a class="topic-row" href="/projects/"><span>03</span><h3>个人项目</h3><p>从灵感、设计到上线的完整记录。</p><b>→</b></a>
			<a class="topic-row" href="/about/"><span>04</span><h3>关于作者</h3><p>了解我的学习方向，以及如何找到我。</p><b>→</b></a>
		</div>
	</section>

	<section class="section shell">
		<div class="section-label">
			<h2>最近更新</h2>
			<a href="/posts/">全部文章 →</a>
		</div>
		<div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
	</section>
</BaseLayout>
