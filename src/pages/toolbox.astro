---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
	{
		id: 'humanizer',
		name: 'humanizer',
		kind: '写作',
		source: 'https://github.com/blader/humanizer',
		repository: 'blader/humanizer',
		description: '检查模板化句式、空泛总结和过度包装，帮助文章表达得更自然。',
		usage: '本站文章修改和定稿时，用它检查重复总结、书面化表达与不必要的强调。博客搭建说明的精简版也做了这一步；技术结论仍需另外核对。',
	},
	{
		id: 'documd-visuals',
		name: 'documd-visuals',
		kind: '图示',
		source: 'https://github.com/markdown-viewer/skills',
		repository: 'markdown-viewer/skills',
		description: '帮助组织技术文章中的流程图和对比图，明确步骤、分支和数据怎样流动。',
		usage: '博客搭建说明里的两张流程图，用它组织了文章生成和浏览量统计的流程，再以 SVG 放进正文。图示保存在仓库中，可以随文章一起修改。',
	},
];
---

<BaseLayout title="工具箱" description="记录本站写作和维护中实际采用的工具，以及具体使用场景。" activeNav="/toolbox/">
	<section class="page-intro shell">
		<p class="eyebrow">TOOLS USED HERE</p>
		<h1>工具箱</h1>
		<p>记录本站写作和维护中实际采用的工具，说明它们用在了哪里。</p>
	</section>

	<section class="toolbox shell" aria-label="工具列表">
		<div class="toolbox-note">
			<strong>收录原则</strong>
			<p>只保留有具体使用记录的工具。仅安装、准备尝试的暂不收录；这里记录的是博客工作流，不代表作者个人日常使用清单。</p>
		</div>
		<div class="tool-list">
			{tools.map((tool, index) => (
				<article class="tool-card" id={tool.id}>
					<div class="tool-number">{String(index + 1).padStart(2, '0')}</div>
					<div class="tool-main">
						<div class="tool-heading">
							<div>
								<span>{tool.kind}</span>
								<h2>{tool.name}</h2>
							</div>
						</div>
						<p>{tool.description}</p>
						<div class="tool-usage"><b>实际用途</b><span>{tool.usage}</span></div>
						<div class="tool-footer">
							<div><span>{tool.repository}</span></div>
							<a href={tool.source} target="_blank" rel="noopener noreferrer">仓库主页 ↗</a>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
