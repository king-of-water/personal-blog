---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.publishedAt);
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const currentIndex = allPosts.findIndex((item) => item.id === post.id);
const newerPost = allPosts[currentIndex - 1];
const olderPost = allPosts[currentIndex + 1];
const articleText = post.body
	.replace(/```[\s\S]*?```/g, ' ')
	.replace(/<[^>]+>/g, ' ')
	.replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
	.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
	.replace(/[`#>*_|~]/g, ' ');
const hanCharacterCount = articleText.match(/\p{Script=Han}/gu)?.length ?? 0;
const latinWordCount = articleText
	.replace(/\p{Script=Han}/gu, ' ')
	.match(/[A-Za-z0-9]+(?:[-'][A-Za-z0-9]+)*/g)?.length ?? 0;
const exactWordCount = hanCharacterCount + latinWordCount;
const approximateWordCount = Math.max(100, Math.round(exactWordCount / 100) * 100);
const readingMinutes = Math.max(1, Math.ceil(exactWordCount / 500));
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<div class="article-layout">
		{tableOfContents.length >= 3 && (
			<aside class="article-sidebar" aria-label="文章目录">
				<div class="article-sidebar-inner">
					<strong>本文目录</strong>
					<ol>
						{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}
					</ol>
				</div>
			</aside>
		)}
		<article class="article">
			<header class="article-header">
				<div class="article-meta"><span>{post.data.category}</span><span>·</span><time datetime={post.data.publishedAt.toISOString()}>{date}</time><span>·</span><span>约 {approximateWordCount.toLocaleString('zh-CN')} 字</span><span>·</span><span>约 {readingMinutes} 分钟阅读</span><span class="article-view-stat" data-view-stat hidden><span>·</span><span data-view-count>0 次浏览</span></span></div>
				<h1>{post.data.title}</h1>
				<p class="article-description">{post.data.description}</p>
			</header>
			<div class="prose"><Content /></div>
			<div class="article-reactions" data-post-stats data-slug={post.id} hidden>
				<p>如果这篇文章对你有帮助</p>
				<button type="button" class="like-button" data-like-button aria-pressed="false">
					<span class="like-icon" aria-hidden="true">♡</span>
					<span data-like-label>赞一下</span>
					<b data-like-count>0</b>
				</button>
			</div>
			<nav class="article-nav" aria-label="文章导航">
				{newerPost ? <a href={`/posts/${newerPost.id}/`}><small>较新文章</small><strong>← {newerPost.data.title}</strong></a> : <span />}
				{olderPost ? <a href={`/posts/${olderPost.id}/`}><small>较早文章</small><strong>{olderPost.data.title} →</strong></a> : <span />}
			</nav>
		</article>
	</div>
	{tableOfContents.length >= 3 && (
		<script>
			const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
			const sections = tocLinks
				.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
				.filter((section): section is HTMLElement => section !== null);
			let ticking = false;

			const updateActiveSection = () => {
				const marker = window.scrollY + Math.min(180, window.innerHeight * 0.28);
				let activeSection = sections[0];
				for (const section of sections) {
					if (section.offsetTop <= marker) activeSection = section;
					else break;
				}

				for (const link of tocLinks) {
					const isActive = activeSection !== undefined && decodeURIComponent(link.hash.slice(1)) === activeSection.id;
					link.classList.toggle('is-active', isActive);
					if (isActive) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				}
				ticking = false;
			};

			const requestUpdate = () => {
				if (!ticking) {
					ticking = true;
					window.requestAnimationFrame(updateActiveSection);
				}
			};

			window.addEventListener('scroll', requestUpdate, { passive: true });
			window.addEventListener('resize', requestUpdate);
			window.addEventListener('hashchange', requestUpdate);
			updateActiveSection();
		</script>
	)}
	<script>
		const statsRoot = document.querySelector<HTMLElement>('[data-post-stats]');
		const viewStat = document.querySelector<HTMLElement>('[data-view-stat]');
		const viewCount = document.querySelector<HTMLElement>('[data-view-count]');
		const likeButton = document.querySelector<HTMLButtonElement>('[data-like-button]');
		const likeLabel = document.querySelector<HTMLElement>('[data-like-label]');
		const likeCount = document.querySelector<HTMLElement>('[data-like-count]');

		if (statsRoot && viewStat && viewCount && likeButton && likeLabel && likeCount) {
			const slug = statsRoot.dataset.slug;
			const visitorStorageKey = 'king-of-water:visitor';
			let visitorId = localStorage.getItem(visitorStorageKey);
			if (!visitorId) {
				visitorId = crypto.randomUUID();
				localStorage.setItem(visitorStorageKey, visitorId);
			}

			const renderStats = (stats: { views: number; likes: number; liked: boolean }) => {
				viewCount.textContent = `${stats.views.toLocaleString('zh-CN')} 次浏览`;
				likeCount.textContent = stats.likes.toLocaleString('zh-CN');
				likeLabel.textContent = stats.liked ? '已点赞' : '赞一下';
				likeButton.setAttribute('aria-pressed', String(stats.liked));
				likeButton.classList.toggle('is-liked', stats.liked);
				likeButton.querySelector('.like-icon')!.textContent = stats.liked ? '♥' : '♡';
				viewStat.hidden = false;
				statsRoot.hidden = false;
			};

			const requestStats = async (action?: 'view' | 'like') => {
				const endpoint = `/api/stats/${encodeURIComponent(slug!)}${action ? '' : `?visitor=${encodeURIComponent(visitorId!)}`}`;
				const response = await fetch(endpoint, action ? {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ action, visitorId }),
				} : undefined);
				if (!response.ok) throw new Error('statistics unavailable');
				return response.json();
			};

			const today = new Date().toISOString().slice(0, 10);
			const viewStorageKey = `king-of-water:view:${slug}:${today}`;
			requestStats(localStorage.getItem(viewStorageKey) ? undefined : 'view')
				.then((stats) => {
					renderStats(stats);
					localStorage.setItem(viewStorageKey, '1');
				})
				.catch(() => {});

			likeButton.addEventListener('click', async () => {
				likeButton.disabled = true;
				try {
					renderStats(await requestStats('like'));
				} catch {
					// Keep the article usable if the statistics service is temporarily unavailable.
				} finally {
					likeButton.disabled = false;
				}
			});
		}
	</script>
</BaseLayout>
