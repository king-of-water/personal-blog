---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="个人">
	<header class="page-intro about-intro shell">
		<div class="about-intro-copy">
			<p class="eyebrow">About</p>
			<h1>关于作者</h1>
			<p>我是一名武汉大学本科生，主要关注后端工程、AI 应用与 Agent 工程。</p>
		</div>
		<figure class="about-companion">
			<figcaption class="about-companion-quote" lang="en">To be,<br />or not to be</figcaption>
			<img src="/images/about-yellow-companion-clear.jpg" alt="头顶白色毛巾、若有所思的黄色小家伙" width="200" height="200" />
		</figure>
	</header>
	<section class="personal-links shell" aria-label="个人入口">
		<a class="personal-entry" href={SITE.github} target="_blank" rel="noopener noreferrer">
			<h2>GitHub <span aria-hidden="true">↗</span></h2>
			<p>查看代码、公开项目与持续更新的记录。</p>
			<span class="visually-hidden">在新标签页打开</span>
		</a>
		<a class="personal-entry" href="/toolbox/">
			<h2>工具箱 <span aria-hidden="true">→</span></h2>
			<p>博客写作和维护中采用的工具，以及具体用途。</p>
		</a>
	</section>
	<section class="friend-links shell" aria-labelledby="friend-links-title">
		<div class="friend-links-heading">
			<h2 id="friend-links-title">友情链接</h2>
			<span>1 位朋友</span>
		</div>
		<a class="friend-card" href="https://n015.top/" target="_blank" rel="noopener noreferrer">
			<div class="friend-card-copy">
				<h3>Elster Lee</h3>
				<p>个人项目与随笔记录。</p>
				<div class="friend-card-footer">
					<span class="friend-domain">n015.top</span>
					<span class="friend-action">访问博客 <span aria-hidden="true">↗</span><span class="visually-hidden">（在新标签页打开）</span></span>
				</div>
			</div>
			<span class="friend-mark" aria-hidden="true">EL</span>
		</a>
	</section>
</BaseLayout>

<style>
	.about-intro { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; gap: 32px; }
	.about-intro-copy { min-width: 0; }
	.about-companion { display: flex; align-items: center; justify-self: end; gap: 18px; margin: 0; }
	.about-companion img { display: block; flex-shrink: 0; width: clamp(160px, 17vw, 200px); height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 44%; border-radius: 50%; padding: 9px; border: 1px solid var(--line); background: var(--paper); box-shadow: 0 7px 22px rgba(83, 65, 42, 0.08); }
	.about-companion-quote { position: relative; flex-shrink: 0; margin: 0; padding: 13px 19px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); color: var(--muted); font-family: var(--display); font-size: clamp(21px, 2vw, 25px); font-style: italic; line-height: 1.3; letter-spacing: -0.025em; box-shadow: 0 4px 14px rgba(83, 65, 42, 0.06); }
	.about-companion-quote::after { content: ""; position: absolute; top: calc(50% - 5px); right: -5px; width: 8px; height: 8px; background: var(--paper); border-top: 1px solid var(--line); border-right: 1px solid var(--line); transform: rotate(45deg); }
	.personal-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-top: 36px; padding-bottom: 48px; }
	.personal-entry { padding: 24px 26px; border: 1px solid var(--line); background: var(--paper); }
	.personal-entry h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin: 0 0 10px; font-family: var(--display); font-size: 28px; font-weight: 600; }
	.personal-entry h2 span { color: var(--accent); font-family: inherit; font-size: 22px; }
	.personal-entry p { margin: 0; color: var(--muted); font-size: 14px; }
	.personal-entry:is(:hover, :focus-visible) { border-color: var(--accent); color: var(--accent); }
	.friend-links { padding: 0 0 72px; }
	.friend-links-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
	.friend-links-heading h2 { margin: 0; font-family: var(--display); font-size: 22px; font-weight: 600; }
	.friend-links-heading > span { color: var(--muted); font-size: 12px; }
	.friend-card { position: relative; display: block; width: min(100%, 820px); overflow: hidden; padding: 36px 38px 26px; border: 1px solid var(--line); background: var(--paper); color: var(--text); }
	.friend-card-copy { position: relative; z-index: 1; max-width: 490px; }
	.friend-card h3 { margin: 0 0 12px; font-family: var(--display); font-size: clamp(32px, 4vw, 46px); font-weight: 600; line-height: 1.1; letter-spacing: -0.035em; }
	.friend-card p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.7; }
	.friend-card-footer { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 26px; margin-top: 36px; font-size: 12px; }
	.friend-domain { color: var(--muted); }
	.friend-action { color: var(--accent); font-weight: 600; }
	.friend-action > span[aria-hidden] { display: inline-block; margin-left: 4px; }
	.friend-mark { position: absolute; right: 24px; top: 50%; transform: translateY(-50%) rotate(-7deg); width: 170px; height: 170px; display: grid; place-items: center; border: 1px solid var(--accent); border-radius: 50%; color: var(--accent); opacity: 0.12; font-family: var(--display); font-size: 108px; font-weight: 600; line-height: 1; letter-spacing: -0.09em; pointer-events: none; user-select: none; }
	.friend-card:hover { border-color: var(--accent); }
	.friend-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.about-companion img { transition: transform 360ms var(--spring-soft), box-shadow 240ms ease; }
		.about-companion:hover img { transform: rotate(-4deg) scale(1.04); box-shadow: 0 12px 26px rgba(83, 65, 42, 0.14); }
		.about-companion-quote { transition: transform 360ms var(--spring-soft), color 220ms ease; transform-origin: right center; }
		.about-companion:hover .about-companion-quote { transform: scale(1.04); color: var(--accent); }
		.personal-entry { transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease; }
		.personal-entry:hover { background: var(--accent-soft); }
		.friend-card { transition: transform 240ms ease, border-color 180ms ease, box-shadow 240ms ease; }
		.friend-card:hover { transform: translateY(-3px); box-shadow: 0 8px 22px rgba(83, 65, 42, 0.07); }
		.friend-mark { transition: opacity 240ms ease, transform 320ms ease; }
		.friend-card:hover .friend-mark { opacity: 0.2; transform: translateY(-50%) rotate(0deg); }
		.friend-action > span[aria-hidden] { transition: transform 240ms ease; }
		.friend-card:hover .friend-action > span[aria-hidden] { transform: translate(2px, -2px); }
	}
	@media (max-width: 960px) {
		.about-intro { grid-template-columns: 1fr; gap: 28px; }
		.about-companion { justify-self: start; }
	}
	@media (max-width: 760px) {
		.about-companion { gap: 16px; }
		.about-companion img { width: 140px; padding: 6px; }
		.about-companion-quote { padding: 12px 16px; font-size: 22px; }
		.personal-links { grid-template-columns: 1fr; gap: 16px; padding-top: 28px; padding-bottom: 36px; }
		.friend-links { padding-bottom: 48px; }
		.friend-links-heading { margin-bottom: 20px; }
		.friend-card { padding: 28px 24px 24px; }
		.friend-card-copy { max-width: 100%; }
		.friend-card-footer { margin-top: 28px; }
		.friend-mark { right: -32px; width: 132px; height: 132px; font-size: 84px; opacity: 0.08; }
	}
</style>
