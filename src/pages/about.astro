---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="关于">
	<header class="page-intro shell">
		<p class="eyebrow">About</p>
		<h1>个人介绍</h1>
		<p>这是 {SITE.author} 的个人技术空间，用来沉淀学习、实践与思考。</p>
	</header>
	<section class="about-grid shell">
		<div class="info-card">
			<h2>这个空间</h2>
			<p>我把后端、Agent 和个人项目分开记录。内容不追求面面俱到，只保留亲自实践、真正理解过的部分。</p>
		</div>
		<div class="info-card">
			<h2>现在</h2>
			<p>正在把这个博客从一个静态页面，慢慢做成可以长期更新的个人技术档案。</p>
		</div>
		<div class="info-card">
			<h2>找到我</h2>
			<p>代码和公开项目会同步到 GitHub。</p>
			<a class="text-link" href={SITE.github} target="_blank" rel="noreferrer">访问 GitHub ↗</a>
		</div>
	</section>
</BaseLayout>
