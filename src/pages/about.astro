---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="关于">
	<header class="page-intro shell">
		<p class="eyebrow">About</p>
		<h1>关于作者</h1>
		<p>我是一名武汉大学本科生，主要关注后端工程、AI 应用与 Agent 开发。</p>
	</header>
	<section class="about-grid shell">
		<div class="info-card">
			<h2>这个空间</h2>
			<p>这里记录学习过程、技术实践和个人项目。内容不追求面面俱到，只保留亲自实践、真正理解过的部分。</p>
		</div>
		<div class="info-card">
			<h2>关注方向</h2>
			<p>后端工程、AI 应用、Agent 开发，以及把想法做成稳定可用的系统。</p>
		</div>
		<div class="info-card">
			<h2>找到我</h2>
			<p>代码和公开项目会同步到 GitHub。</p>
			<a class="text-link" href={SITE.github} target="_blank" rel="noreferrer">访问 GitHub ↗</a>
		</div>
	</section>
</BaseLayout>
